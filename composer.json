{
  "name": "k2gl/openvex",
  "description": "Read, write and canonicalize OpenVEX documents in PHP",
  "homepage": "https://github.com/k2gl/openvex",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "openvex",
    "vex",
    "vulnerability",
    "exploitability",
    "advisory",
    "sbom",
    "supply-chain",
    "in-toto",
    "attestation",
    "openssf"
  ],
  "authors": [
    {
      "name": "Nick Harin",
      "email": "l0gic@ya.ru"
    }
  ],
  "support": {
    "issues": "https://github.com/k2gl/openvex/issues",
    "source": "https://github.com/k2gl/openvex"
  },
  "require": {
    "php": ">=8.1",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10|^11|^12",
    "phpstan/phpstan": "^2.1",
    "laravel/pint": "~1.20.0",
    "k2gl/phpunit-fluent-assertions": "^12"
  },
  "autoload": {
    "psr-4": {
      "K2gl\\OpenVex\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "K2gl\\OpenVex\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs": "pint --test",
    "cs-fix": "pint",
    "check": [
      "@test",
      "@phpstan",
      "@cs"
    ]
  }
}
